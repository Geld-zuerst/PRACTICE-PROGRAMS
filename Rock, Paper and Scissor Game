import random
import tkinter as tk


BACKGROUND = "#101827"
CARD = "#1c2940"
TEXT = "#f3f6fc"
MUTED = "#a9b5c9"
ACCENT = "#6c8cff"

wd = tk.Tk()
wd.title("Rock, Paper, Scissors")
wd.geometry("560x520")
wd.minsize(500, 480)
wd.configure(bg=BACKGROUND)

user_choice = tk.StringVar(value="You: —")
comp_choice = tk.StringVar(value="Computer: —")
result_text = tk.StringVar(value="Choose your move to play")


def play(choice):
    comp = random.choice(["Rock", "Paper", "Scissors"])
    user_choice.set(f"You: {choice}")
    comp_choice.set(f"Computer: {comp}")

    if choice == comp:
        result_text.set("It's a tie!")
        result_label.configure(fg="#f6c85f")
    elif (
        (choice == "Rock" and comp == "Scissors")
        or (choice == "Paper" and comp == "Rock")
        or (choice == "Scissors" and comp == "Paper")
    ):
        result_text.set("You win!")
        result_label.configure(fg="#59d69b")
    else:
        result_text.set("Computer wins!")
        result_label.configure(fg="#ff7777")


content = tk.Frame(wd, bg=BACKGROUND, padx=32, pady=28)
content.pack(fill="both", expand=True)

tk.Label(
    content,
    text="ROCK  •  PAPER  •  SCISSORS",
    bg=BACKGROUND,
    fg=TEXT,
    font=("Arial", 25, "bold"),
).pack(pady=(8, 4))

tk.Label(
    content,
    text="Make your move",
    bg=BACKGROUND,
    fg=MUTED,
    font=("Arial", 13),
).pack(pady=(0, 25))

button_frame = tk.Frame(content, bg=BACKGROUND)
button_frame.pack(fill="x", pady=(0, 24))


def add_choice_button(choice):
    button = tk.Button(
        button_frame,
        text=choice,
        command=lambda: play(choice),
        bg="#ffffff",
        fg=BACKGROUND,
        activebackground="#dce5ff",
        activeforeground=BACKGROUND,
        font=("Arial", 16, "bold"),
        relief="raised",
        bd=2,
        padx=14,
        pady=18,
        cursor="hand2",
    )
    button.pack(side="left", expand=True, fill="x", padx=6, ipady=6)


for move in ("Rock", "Paper", "Scissors"):
    add_choice_button(move)

choices_card = tk.Frame(content, bg=CARD, padx=20, pady=17)
choices_card.pack(fill="x", pady=(0, 18))

tk.Label(
    choices_card,
    text="YOUR CHOICE",
    bg=CARD,
    fg=MUTED,
    font=("Arial", 10, "bold"),
    anchor="w",
).pack(fill="x", pady=5)

tk.Label(
    choices_card,
    textvariable=user_choice,
    bg=CARD,
    fg=TEXT,
    font=("Arial", 18, "bold"),
    anchor="w",
).pack(fill="x", pady=(0, 10))

tk.Label(
    choices_card,
    text="COMPUTER'S CHOICE",
    bg=CARD,
    fg=MUTED,
    font=("Arial", 10, "bold"),
    anchor="w",
).pack(fill="x", pady=5)

tk.Label(
    choices_card,
    textvariable=comp_choice,
    bg=CARD,
    fg=TEXT,
    font=("Arial", 18, "bold"),
    anchor="w",
).pack(fill="x", pady=(0, 5))

result_label = tk.Label(
    content,
    textvariable=result_text,
    bg=BACKGROUND,
    fg=ACCENT,
    font=("Arial", 21, "bold"),
    pady=14,
)
result_label.pack()

wd.mainloop()
